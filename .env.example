# 不填写任何密钥时，系统自动使用 Mock Provider。
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
MAX_IMAGE_SIZE_MB=8

# 豆包摄像头画面理解：auto | mock | doubao。
# ARK_API_KEY 是火山方舟控制台创建的 API Key，不是 AK/SK，也不是豆包语音 AccessToken。
CLASSROOM_ANALYSIS_PROVIDER=auto
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_MODEL=doubao-seed-2-0-lite-260215
ARK_VIDEO_FPS=1.0
ARK_VIDEO_MAX_OUTPUT_TOKENS=8000
CLASSROOM_ANALYSIS_TIMEOUT_SECONDS=1200
CLASSROOM_ANALYSIS_MAX_VIDEO_MB=50
LIVE_ANALYSIS_INTERVAL_SECONDS=3
LIVE_ANALYSIS_TIMEOUT_SECONDS=45
LIVE_FRAME_MAX_SIZE_MB=3

# 媒体存储：local | tos | auto。真实 OmniHuman 必须使用 tos。
MEDIA_STORE_PROVIDER=auto
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
TOS_URL_EXPIRES_SECONDS=3600

# 数字人：mock | volcengine | auto
DIGITAL_HUMAN_PROVIDER=auto
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_OMNI_SUBMIT_URL=
VOLCENGINE_OMNI_RESULT_URL=
VOLCENGINE_REGION=cn-north-1
DIGITAL_HUMAN_TIMEOUT_SECONDS=300

# 自然待机动画：auto 会在 AK/SK 齐全时调用即梦图生视频 3.0；失败自动使用本地照片动效。
IDLE_VIDEO_PROVIDER=auto
VOLCENGINE_IDLE_SUBMIT_URL=https://visual.volcengineapi.com/?Action=JimengI2VFirstV30SubmitTask&Version=2024-06-06
VOLCENGINE_IDLE_RESULT_URL=https://visual.volcengineapi.com/?Action=JimengI2VFirstV30GetResult&Version=2024-06-06
IDLE_VIDEO_TIMEOUT_SECONDS=600
IDLE_VIDEO_FRAMES=121

# 语音：mock | doubao | auto
TTS_PROVIDER=auto
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE=BV700_streaming
